#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,,,,,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&kp GRAVE>;
            key-positions = <11 12>;
        };

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        br: br {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BACKSLASH &kp N>;
            label = "BR";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E     &kp R   &kp T                                    &kp Y      &kp U  &kp I      &kp O          &kp P
&mt LCTRL A       &kp S         &kp D     &kp F   &kp G                                    &kp H      &kp J  &lt 5 K    &kp L          &mt RCTRL MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C     &kp V   &kp B                                    &kp N      &kp M  &kp COMMA  &kp DOT        &mt RIGHT_SHIFT SLASH
&kp SPACE         &kp LEFT_ALT  &kp LCMD  &trans  &lt 5 LANG2  &lt 1 SPACE    &lt 2 LANG1  &kp ENTER         &kp RCMD   &kp RIGHT_ALT  &kp BACKSPACE
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        //1

        MOUSE {
            bindings = <
&trans                &trans    &trans            &trans           &trans                            &kp F7         &kp F12         &trans          &trans           &trans
&trans                &kp HOME  &kp LG(KP_EQUAL)  &kp LC(TAB)      &kp K_COPY                        &mkp MB5       &mkp LCLK       &kp UP_ARROW    &mkp RCLK        &kp RG(RA(UP_ARROW))
&trans                &kp END   &kp LG(KP_MINUS)  &kp LC(LS(TAB))  &kp K_PASTE                       &mkp MB4       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp RA(RG(DOWN_ARROW))
&kp LS(LG(NUMBER_5))  &trans    &trans            &trans           &trans       &trans    &kp LG(T)  &kp RS(RG(C))                  &trans          &trans           &kp RS(RG(RC(N4)))
            >;
        };

        //2

        MARK {
            bindings = <
&kp ESCAPE      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR      &kp PERCENT                           &kp AMPERSAND   &kp HASH          &kp DOUBLE_QUOTES  &kp SEMICOLON         &br
&kp TAB         &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp ASTERISK    &kp PLUS                              &kp KP_EQUAL    &kp LS(QUESTION)  &kp SINGLE_QUOTE   &kp COLON             &kp CARET
&kp LEFT_SHIFT  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT_SIGN     &kp KP_SUBTRACT                       &kp UNDERSCORE  &kp EXCL          &kp LS(LESS_THAN)  &kp LS(GREATER_THAN)  &kp LS(SLASH)
&kp TILDE       &kp LEFT_ALT          &kp LCMD               &kp LEFT_SHIFT  &kp SPACE        &kp TILDE    &trans  &trans                            &trans             &trans                &kp LS(BACKSLASH)
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3

        CURSOR {
            bindings = <
&kp COLON   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0                            &kp K_MUTE    &trans  &trans  &trans  &trans
&kp LCTRL   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp COMMA                               &kp C_VOL_UP  &trans  &trans  &trans  &trans
&kp LSHIFT  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD                              &kp C_VOL_DN  &trans  &trans  &trans  &trans
&mo 6       &kp LEFT_ALT  &kp LCMD      &trans        &kp SPACE     &kp UNDERSCORE    &trans  &trans                &trans  &trans  &trans
            >;
        };

        //4

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5                     &trans      &trans  &kp LA(PRINTSCREEN)  &trans  &kp LC(LA(DELETE))
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10                    &trans      &trans  &kp LS(LG(S))        &trans  &kp LC(LS(ESCAPE))
&trans  &trans  &trans  &kp F11  &kp F12                    &kp C_MUTE  &trans  &trans               &trans  &kp LC(LA(INS))
&trans  &trans  &trans  &trans   &trans   &trans    &trans  &trans              &trans               &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //5

        SCROLL {
            bindings = <
&kp COLON         &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0                            &kp K_MUTE    &trans  &trans  &trans  &trans
&kp LEFT_CONTROL  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp COMMA                               &kp C_VOL_UP  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD                              &kp C_VOL_DN  &trans  &trans  &trans  &trans
&mo 6             &kp LEFT_ALT  &kp LCMD      &trans        &kp SPACE     &kp UNDERSCORE    &trans  &trans                &trans  &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_LEFT SCRL_RIGHT>;
        };

        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
